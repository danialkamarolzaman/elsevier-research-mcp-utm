# Settings for elsevier-research-mcp-utm. Copy the lines you need into the config file
#   macOS / Linux: ~/.config/elsevier-research-mcp-utm/.env   (then: chmod 600 <file>)
#   Windows:       %APPDATA%\elsevier-research-mcp-utm\.env
# or set them as environment variables (these win over the file). Never commit real values.

# required: from https://dev.elsevier.com
ELSEVIER_API_KEY=

# optional: institution token from your library (unlocks full text off-campus)
ELSEVIER_INSTTOKEN=

# optional: your email for the OpenAlex polite pool
OPENALEX_MAILTO=

# optional: Semantic Scholar API key (higher rate limit; works without one)
SEMANTIC_SCHOLAR_API_KEY=

# optional: paths
ERM_CACHE_DIR=
ERM_DOWNLOAD_DIR=
ERM_PDF_NAME={first_author} {year} - {title}
ERM_CACHE_DAYS=30

# institution rules (UTM Library defaults)
ERM_PROXY_HOST=ezproxy.utm.my
ERM_MAX_ARTICLES_PER_WINDOW=5
ERM_MAX_MB_PER_WINDOW=100
ERM_WINDOW_MINUTES=15
ERM_MAX_ARTICLES_PER_DAY=20
ERM_MIN_DELAY_SECONDS=10
